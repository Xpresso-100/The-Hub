# The Hub - folder-level protection. build-bundle.ps1 ships this as .htaccess in the hub/ folder.
# Only public/ is meant to be reached from a browser; src/, db/, bin/, var/ carry their own deny rules too.
Options -Indexes
<FilesMatch "(^config\.local\.php|\.TEMPLATE|\.sql|\.md|\.env.*)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ public/ [R=302,L]
</IfModule>
