# The Hub - Apache (xneelo). Everything that is not a real file goes to index.php (SPEC s2.4).
Options -Indexes
DirectoryIndex index.html

<FilesMatch "\.(log|txt|sqlite|sqlite3|sql|md|ini|env)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
