# The Hub - configuration keys (SPEC s2.2). PLACEHOLDERS ONLY - never put real values in git.
#
# Resolution order per key: real environment variable > config.local.php at the repo root
# (gitignored; `<?php return ['KEY' => 'value', ...];`) > default in src/Config.php.
# The app never reads a .env file; this file only documents the keys.

APP_ENV=production
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placeholder_hub_db
DB_USER=placeholder_hub_user
DB_PASS=placeholder-db-password
DB_PATH=var/hub.sqlite

AUTH_TOKEN_TTL_HOURS=8

# FinCon - read only, via the existing Cloudflare Tunnel. `mock` is refused when APP_ENV=production.
FINCON_ADAPTER=http
FINCON_BASE_URL=https://fincon-api.example.invalid
FINCON_CF_CLIENT_ID=placeholder-cf-access-client-id
FINCON_CF_CLIENT_SECRET=placeholder-cf-access-client-secret
FINCON_SRV_USER=placeholder-fincon-server-user
FINCON_SRV_PASS=placeholder-fincon-server-password
FINCON_DATA_ID=placeholder-fincon-data-id
FINCON_USER=placeholder-fincon-user
FINCON_PASS=placeholder-fincon-password
FINCON_LOC_NO=0
FINCON_TIMEOUT_SECONDS=15
FINCON_MOCK_LOG=
STOCK_CACHE_TTL_SECONDS=900

# Mail - `mail` = PHP mail() (production default), `log` = JSON lines in MAIL_LOG_PATH
MAIL_TRANSPORT=mail
MAIL_LOG_PATH=var/mail.log
MAIL_FROM=noreply@example.invalid
HQ_ORDERS_EMAIL=hq-orders@example.invalid
