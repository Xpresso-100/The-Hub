.run/

# Secrets and local configuration - never committed (SPEC s2.2)
.env
.env.*
!.env.example
config.local.php

# Runtime data: SQLite files, logs, test apps
var/*
!var/.htaccess
*.sqlite
*.sqlite3
*.log

# Dependencies (none today - the stack has no Composer/npm) and build output
vendor/
node_modules/
build/
dist/

# Editor / OS noise
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Claude Code worktrees (save-ship install.ps1)
.claude/worktrees/

# Stop verify-gate counters (per session, local only)
.claude/verify-gate-*.count

# Browser test scratch inside the upload copy (tests/browser/serve.php --root bundle)
/deploy/upload/hub/var/test/
